# Server
PORT=3000
HOST=0.0.0.0
JWT_SECRET=replace-with-a-long-random-string

# Password reset delivery (Resend HTTP API).
# Production must configure both values; reset codes are never returned by the API.
# RESEND_API_KEY=re_...
# PASSWORD_RESET_FROM_EMAIL=ZNWriter <no-reply@example.com>
# Local-only escape hatch: explicitly expose a dev code in the UI.
# Never enable this in production.
# PASSWORD_RESET_DEV_MODE=true

# Optional primary database.
# If omitted in development, the server falls back to local SQLite at server/data/prowriter.db.
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/mythwriter

# Optional Redis for cache/rate-limit/session helpers.
# REDIS_URL=redis://127.0.0.1:6379

# Optional chat model defaults. Users can override these in the app settings.
DEFAULT_CHAT_API_BASE_URL=https://api.deepseek.com/v1
DEFAULT_CHAT_MODEL=deepseek-chat
# DEFAULT_CHAT_API_KEY=

# Optional semantic retrieval.
# Leave these blank to run the app without vector search.
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# MILVUS_ADDRESS=http://127.0.0.1:19530
# MILVUS_TIMEOUT_MS=3000
