{
  "name": "prowriter-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:watch": "tsx watch src/index.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "build": "tsc",
    "start": "node scripts/start.js",
    "setup-local": "tsx scripts/ensure-local-config.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate-sqlite": "prisma generate --schema=prisma/schema-sqlite.prisma",
    "db:push-sqlite": "tsx scripts/setup-sqlite.ts",
    "setup-sqlite": "tsx scripts/setup-sqlite.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.5",
    "@prisma/client": "^6.5.0",
    "@zilliz/milvus2-sdk-node": "^2.4.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.13.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
