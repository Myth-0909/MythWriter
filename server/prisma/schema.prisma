generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String     @id @default(uuid())
  name              String
  email             String     @unique
  password          String
  avatar            String?
  apiKey            String?    @default("sk-7d2a5b1c9e4f8a0b3c6d9e1f2a5b8c4d") @map("api_key")
  apiBaseUrl        String     @default("http://172.16.76.112:8000/v1") @map("api_base_url")
  aiModel           String     @default("google/gemma-4-31B-it") @map("ai_model")
  lang              String     @default("zh") @map("lang")
  resetToken        String?    @map("reset_token")
  resetTokenExpires DateTime?  @map("reset_token_expires")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  documents       Document[]
  conversations   Conversation[]
  feedbacks       ChatFeedback[]
  activityLogs    ActivityLog[]
  brainKnowledges AIBrainKnowledge[]
  documentGroups  DocumentGroup[]
  apiKeyHistories  ApiKeyConfigHistory[]

  @@map("users")
}

model ApiKeyConfigHistory {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  apiKey     String   @map("api_key")
  apiBaseUrl String   @map("api_base_url")
  aiModel    String   @map("ai_model")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_key_config_histories")
}

model Document {
  id         String           @id @default(uuid())
  title      String
  content    String           @db.LongText
  preview    String?
  tags       Json?
  category   DocumentCategory @default(general)
  isFavorite Boolean          @default(false) @map("is_favorite")
  isDeleted  Boolean          @default(false) @map("is_deleted")
  deletedAt  DateTime?        @map("deleted_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId String?        @map("group_id")
  group   DocumentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isDeleted])
  @@index([groupId])
  @@map("documents")
}

enum DocumentCategory {
  design
  journal
  planning
  research
  general
}

model Conversation {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  messages   Json
  personality String  @default("normal")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("conversations")
}

model ChatFeedback {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  messageContent String @map("message_content") @db.LongText
  feedbackType String  @map("feedback_type") // "like" | "dislike"
  rating     Int?     // 1-5 for likes
  reason     String?  // for dislikes: reason text
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("chat_feedbacks")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String   // e.g. "chat_open", "chat_send", "chat_feedback", "chat_delete", "chat_clear"
  detail    String?  // optional extra info (personality, message count, etc.)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, action])
  @@map("activity_logs")
}

model DocumentGroup {
  id        String     @id @default(uuid())
  name      String
  userId    String     @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([userId])
  @@map("document_groups")
}

model AIBrainKnowledge {
  id          String   @id @default(uuid())
  title       String   // e.g. "林动", "大炎王朝"
  description String   @db.Text // The description / lore setting
  category    String   @default("character") // "character" | "location" | "concept" | "other"
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_brain_knowledges")
}
