generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String     @id @default(uuid())
  name              String
  email             String     @unique
  password          String
  avatar            String?
  apiKey            String?    @map("api_key")
  apiBaseUrl        String     @default("https://api.deepseek.com/v1") @map("api_base_url")
  aiModel           String     @default("deepseek-chat") @map("ai_model")
  embeddingApiKey   String?    @map("embedding_api_key")
  embeddingBaseUrl  String?    @map("embedding_base_url")
  embeddingModel    String?    @map("embedding_model")
  lang              String     @default("zh") @map("lang")
  fontFamilyKey     String     @default("current") @map("font_family_key")
  resetToken        String?    @map("reset_token")
  resetTokenExpires DateTime?  @map("reset_token_expires")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  documents       Document[]
  conversations   Conversation[]
  feedbacks       ChatFeedback[]
  activityLogs    ActivityLog[]
  brainKnowledges AIBrainKnowledge[]
  brainCategories AIBrainCategory[]
  documentGroups  DocumentGroup[]
  apiKeyHistories  ApiKeyConfigHistory[]
  documentVersions DocumentVersion[]
  workRecords      WorkRecord[]
  spreadsheets     Spreadsheet[]

  @@map("users")
}

model ApiKeyConfigHistory {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  apiKey     String   @map("api_key")
  apiBaseUrl String   @map("api_base_url")
  aiModel    String   @map("ai_model")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_key_config_histories")
}

model Document {
  id         String           @id @default(uuid())
  title      String
  content    String           @db.LongText
  preview    String?
  tags       Json?
  category   DocumentCategory @default(general)
  isFavorite Boolean          @default(false) @map("is_favorite")
  isDeleted  Boolean          @default(false) @map("is_deleted")
  deletedAt  DateTime?        @map("deleted_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId String?        @map("group_id")
  group   DocumentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  versions DocumentVersion[]

  @@index([userId])
  @@index([userId, isDeleted])
  @@index([groupId])
  @@map("documents")
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  userId     String   @map("user_id")
  title      String
  content    String   @db.LongText
  preview    String?
  source     String   @default("manual")
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId])
  @@index([documentId, createdAt])
  @@map("document_versions")
}

model Spreadsheet {
  id        String   @id @default(uuid())
  title     String
  data      Json
  preview   String?
  isDeleted Boolean  @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId String?        @map("group_id")
  group   DocumentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isDeleted])
  @@index([groupId])
  @@map("spreadsheets")
}

enum DocumentCategory {
  design
  journal
  planning
  research
  general
}

model Conversation {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  messages   Json
  personality String  @default("normal")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("conversations")
}

model ChatFeedback {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  messageContent String @map("message_content") @db.LongText
  feedbackType String  @map("feedback_type") // "like" | "dislike"
  rating     Int?     // 1-5 for likes
  reason     String?  // for dislikes: reason text
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("chat_feedbacks")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String   // e.g. "chat_open", "chat_send", "chat_feedback", "chat_delete", "chat_clear"
  detail    String?  // optional extra info (personality, message count, etc.)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, action])
  @@map("activity_logs")
}

model WorkRecord {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  period     WorkRecordPeriod
  targetDate DateTime         @map("target_date")
  title      String
  content    String           @db.LongText
  aiSummary  String?          @map("ai_summary") @db.LongText
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, targetDate])
  @@index([userId])
  @@index([userId, period, targetDate])
  @@map("work_records")
}

enum WorkRecordPeriod {
  daily
  weekly
  monthly
}

model DocumentGroup {
  id        String     @id @default(uuid())
  name      String
  userId    String     @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]
  spreadsheets Spreadsheet[]

  @@index([userId])
  @@map("document_groups")
}

model AIBrainCategory {
  id          String   @id @default(uuid())
  name        String   // e.g. "角色", "势力", "世界观"
  color       String?  // optional hex color for the tab pill
  sortOrder   Int      @default(0) @map("sort_order")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledges  AIBrainKnowledge[]

  @@index([userId])
  @@map("ai_brain_categories")
}

model AIBrainKnowledge {
  id          String   @id @default(uuid())
  title       String   // e.g. "林动", "大炎王朝"
  description String   @db.Text // The description / lore setting
  category    String   @default("") // references AIBrainCategory.name, empty = unclassified
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryRef AIBrainCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?  @map("category_id")

  @@index([userId])
  @@index([categoryId])
  @@map("ai_brain_knowledges")
}
